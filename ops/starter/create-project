#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd -P)"
mode="" layout="" slug="" name="" target=""
die() { echo "create-project: $*" >&2; exit 1; }
while (( $# )); do
  case "$1" in
    --mode|--layout|--slug|--name|--target)
      (( $# >= 2 )) || die "Missing value for $1"
      case "$1" in
        --mode) mode="$2";; --layout) layout="$2";; --slug) slug="$2";;
        --name) name="$2";; --target) target="$2";;
      esac
      shift 2;;
    *) die "Unknown argument $1";;
  esac
done
[[ "$mode" == headless || "$mode" == standard ]] || die "Invalid mode"
[[ "$layout" == standalone || "$layout" == monorepo ]] || die "Invalid layout"
[[ "$slug" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] || die "Invalid slug"
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._\ \&-]*$ ]] || die "Invalid project name (letters, digits, spaces, . _ & - only)"
[[ -n "$target" && "$target" != / && ! -L "$target" ]] || die "Invalid target"
if [[ -e "$target" ]]; then
  [[ -d "$target" && -z "$(ls -A "$target")" ]] || die "Target must be empty"
fi
mkdir -p "$target"
DEST="$(cd "$target" && pwd -P)"
[[ "$DEST" != "$ROOT" && "$DEST" != "$ROOT/"* ]] || die "Destination inside starter"

copy_list() {
  local item
  while IFS= read -r item || [[ -n "$item" ]]; do
    [[ -z "$item" || "$item" == \#* ]] && continue
    [[ -e "$ROOT/$item" ]] || die "Missing source $item"
    mkdir -p "$DEST/$(dirname "$item")"
    cp -R "$ROOT/$item" "$DEST/$item"
  done < "$ROOT/ops/starter/manifests/$1.list"
}
render() {
  local file path line
  while IFS= read -r -d '' file; do
    path="${file#"$ROOT/ops/starter/templates/$1/"}"
    path="${path%.tpl}"
    path="${path//__SLUG__/$slug}"
    [[ ! -e "$DEST/$path" ]] || die "Template collision $path"
    mkdir -p "$DEST/$(dirname "$path")"
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//__SLUG__/$slug}"
      line="${line//__PROJECT_NAME__/$name}"
      line="${line//__LAYOUT__/$layout}"
      printf '%s\n' "$line"
    done < "$file" > "$DEST/$path"
  done < <(find "$ROOT/ops/starter/templates/$1" -type f -print0)
}
copy_list common
[[ "$mode" == headless ]] && copy_list headless
render common
render "$mode"
[[ ! -e "$DEST/composer.lock" ]] || die "Lock copied unexpectedly"
if grep -R -E '__SLUG__|__PROJECT_NAME__|__LAYOUT__' "$DEST/README.md" "$DEST/PROJECT.md" "$DEST/config/wordpress.php" "$DEST/composer.json" "$DEST/src"; then
  die "Unresolved placeholders"
fi
echo "Created $mode/$layout project at $DEST"
