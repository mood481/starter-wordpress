#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cat >&2 <<'EOF'
The legacy Twenty Twenty-Five child-theme bootstrap is retired.
Create a standalone standard project with its own theme using:
  ./ops/starter/create-project --mode standard --layout standalone \
    --slug <slug> --name "<name>" --target <empty-directory>
Existing projects should manage their project-owned theme in src/themes/.
EOF
exit 2
