#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

usage() {
    cat <<'EOF'
Usage:
  ./ops/starter/bootstrap-theme <slug> <name>
  ./ops/starter/bootstrap-theme --test

Examples:
  ./ops/starter/bootstrap-theme llif "Llif"
  ./ops/starter/bootstrap-theme --test
EOF
}

bootstrap_theme() {
    local root="$1"
    local slug="$2"
    local name="$3"

    local wordpress_config="$root/config/wordpress.php"
    local themes_dir="$root/src/themes"
    local target_dir="$themes_dir/$slug"
    local tmp_config

    if [[ ! "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
        echo "Invalid theme slug: $slug" >&2
        echo "Use lowercase letters, numbers and single hyphens only." >&2
        return 1
    fi

    if [[ -z "$name" ]]; then
        echo "Theme name must not be empty." >&2
        return 1
    fi

    if [[ ! -f "$wordpress_config" ]]; then
        echo "Missing WordPress configuration: $wordpress_config" >&2
        return 1
    fi

    if [[ -e "$target_dir" ]]; then
        echo "Theme already exists: $target_dir" >&2
        return 1
    fi

    if ! grep -Fq "'parent' => 'twentytwentyfive'," "$wordpress_config"; then
        echo "Expected parent theme twentytwentyfive in config/wordpress.php." >&2
        return 1
    fi

    if ! grep -Fq "'active' => 'twentytwentyfive'," "$wordpress_config"; then
        echo "The starter theme has already been configured or config/wordpress.php has changed." >&2
        return 1
    fi

    mkdir -p "$target_dir"

    cat > "$target_dir/style.css" <<EOF
/*
Theme Name: $name
Template: twentytwentyfive
Version: 0.1.0
Text Domain: $slug
*/
EOF

    cat > "$target_dir/theme.json" <<'EOF'
{
  "version": 3,
  "settings": {},
  "styles": {}
}
EOF

    tmp_config="$(mktemp)"

    if ! awk -v slug="$slug" '
        {
            if ($0 ~ /^[[:space:]]*'\''active'\''[[:space:]]*=>[[:space:]]*'\''twentytwentyfive'\'',[[:space:]]*$/) {
                match($0, /^[[:space:]]*/)
                indent = substr($0, 1, RLENGTH)
                print indent "'\''active'\'' => '\''" slug "'\'',"
                next
            }

            print
        }
    ' "$wordpress_config" > "$tmp_config"; then
        rm -f "$tmp_config"
        rm -rf "$target_dir"
        return 1
    fi

    if cmp -s "$wordpress_config" "$tmp_config"; then
        echo "Unable to update active theme in config/wordpress.php." >&2
        rm -f "$tmp_config"
        rm -rf "$target_dir"
        return 1
    fi

    cat "$tmp_config" > "$wordpress_config"
    rm -f "$tmp_config"

    echo "==> Theme bootstrapped"
    echo
    echo "Theme:"
    echo "  $name ($slug)"
    echo
    echo "Created:"
    echo "  src/themes/$slug/style.css"
    echo "  src/themes/$slug/theme.json"
    echo
    echo "Updated:"
    echo "  config/wordpress.php"
}

self_test() {
    local test_root
    test_root="$(mktemp -d)"

    cleanup() {
        rm -rf "$test_root"
    }

    trap cleanup EXIT INT TERM

    mkdir -p \
        "$test_root/config" \
        "$test_root/src/themes"

    cat > "$test_root/config/wordpress.php" <<'EOF'
<?php

declare(strict_types=1);

return [
    'theme' => [
        'parent' => 'twentytwentyfive',
        'active' => 'twentytwentyfive',
    ],

    'plugins' => [],
];
EOF

    echo "==> Testing starter theme bootstrap"

    bootstrap_theme \
        "$test_root" \
        "gear-test" \
        "Gear Test"

    [[ -f "$test_root/src/themes/gear-test/style.css" ]]
    [[ -f "$test_root/src/themes/gear-test/theme.json" ]]

    grep -Fq "Theme Name: Gear Test" \
        "$test_root/src/themes/gear-test/style.css"

    grep -Fq "Template: twentytwentyfive" \
        "$test_root/src/themes/gear-test/style.css"

    grep -Fq "Text Domain: gear-test" \
        "$test_root/src/themes/gear-test/style.css"

    grep -Fq "'active' => 'gear-test'," \
        "$test_root/config/wordpress.php"

    if bootstrap_theme \
        "$test_root" \
        "gear-test" \
        "Gear Test" \
        >/dev/null 2>&1; then
        echo "Bootstrap unexpectedly allowed an existing theme." >&2
        exit 1
    fi

    cleanup
    trap - EXIT INT TERM

    echo "==> Starter theme bootstrap test passed"
}

if [[ "${1:-}" == "--test" ]]; then
    if [[ $# -ne 1 ]]; then
        usage >&2
        exit 1
    fi

    self_test
    exit 0
fi

if [[ $# -ne 2 ]]; then
    usage >&2
    exit 1
fi

bootstrap_theme "$REPO_ROOT" "$1" "$2"
