#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/build"
DIST_DIR="$ROOT/dist"

cd "$ROOT"

required_paths=(
    "$BUILD_DIR/public"
    "$BUILD_DIR/config"
    "$BUILD_DIR/vendor"
    "$BUILD_DIR/public/wp"
)

for path in "${required_paths[@]}"; do
    if [[ ! -e "$path" ]]; then
        echo "Missing build artifact: $path" >&2
        echo "Run ./ops/test before packaging." >&2
        exit 1
    fi
done

PACKAGE_NAME="${PACKAGE_NAME:-$(basename "$ROOT")}"
GIT_COMMIT="${GIT_COMMIT:-$(git rev-parse HEAD)}"
SHORT_COMMIT="${GIT_COMMIT:0:12}"
SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct "$GIT_COMMIT")}"

ARCHIVE_NAME="${PACKAGE_NAME}-${SHORT_COMMIT}.tar.gz"
ARCHIVE="$DIST_DIR/$ARCHIVE_NAME"
CHECKSUM="$ARCHIVE.sha256"

echo "==> Packaging release"
echo "    commit: $GIT_COMMIT"

rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"

if tar --version 2>/dev/null | grep -q "GNU tar"; then
    # Produce deterministic archives on the Linux CI environment.
    tar \
        --sort=name \
        --mtime="@${SOURCE_DATE_EPOCH}" \
        --owner=0 \
        --group=0 \
        --numeric-owner \
        -C "$BUILD_DIR" \
        -cf - \
        config \
        vendor \
        public \
        | gzip -n > "$ARCHIVE"
else
    # Portable fallback, mainly for local environments using BSD tar.
    tar \
        -C "$BUILD_DIR" \
        -czf "$ARCHIVE" \
        config \
        vendor \
        public
fi

if command -v sha256sum >/dev/null 2>&1; then
    (
        cd "$DIST_DIR"
        sha256sum "$ARCHIVE_NAME" > "$(basename "$CHECKSUM")"
    )
elif command -v shasum >/dev/null 2>&1; then
    (
        cd "$DIST_DIR"
        shasum -a 256 "$ARCHIVE_NAME" > "$(basename "$CHECKSUM")"
    )
else
    echo "No SHA-256 utility found." >&2
    exit 1
fi

echo "==> Package complete"
echo
echo "Archive:"
echo "  $ARCHIVE"
echo
echo "Checksum:"
cat "$CHECKSUM"