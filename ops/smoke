#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT/ops/docker/smoke.compose.yml"

export SMOKE_PORT="${SMOKE_PORT:-8080}"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-wordpress-gear-smoke-$RANDOM}"

COMPOSE=(
    docker compose
    --file "$COMPOSE_FILE"
)

cleanup() {
    echo "==> Stopping smoke environment"

    "${COMPOSE[@]}" down \
        --volumes \
        --remove-orphans \
        >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

if [[ ! -f "$ROOT/build/public/wp/wp-settings.php" ]]; then
    echo "Missing build artifact. Run ./ops/build first." >&2
    exit 1
fi

if [[ ! -f "$ROOT/build/config/wordpress.php" ]]; then
    echo "Missing WordPress state configuration in build artifact." >&2
    exit 1
fi

echo "==> Starting MariaDB and WordPress runtime"

"${COMPOSE[@]}" up \
    --detach \
    --build \
    db app

echo "==> Preparing writable runtime state"

"${COMPOSE[@]}" exec \
    -T \
    --user root \
    app \
    chown -R 33:33 /var/www/public/wp-content/uploads

echo "==> Reading expected WordPress state"

THEME_PARENT="$(
    "${COMPOSE[@]}" exec -T app php -r '
        $config = require "/var/www/config/wordpress.php";
        echo $config["theme"]["parent"] ?? "";
    '
)"

THEME_ACTIVE="$(
    "${COMPOSE[@]}" exec -T app php -r '
        $config = require "/var/www/config/wordpress.php";
        echo $config["theme"]["active"] ?? "";
    '
)"

if [[ -z "$THEME_PARENT" ]]; then
    echo "Missing theme.parent in config/wordpress.php." >&2
    exit 1
fi

if [[ -z "$THEME_ACTIVE" ]]; then
    echo "Missing theme.active in config/wordpress.php." >&2
    exit 1
fi

echo "==> Installing WordPress"

"${COMPOSE[@]}" run --rm cli \
    core install \
    --path=/var/www/public/wp \
    --url="http://127.0.0.1:${SMOKE_PORT}" \
    --title="WordPress Gear Smoke" \
    --admin_user=admin \
    --admin_password=smoke-password \
    --admin_email=admin@example.test \
    --skip-email

echo "==> Applying WordPress state"

"${COMPOSE[@]}" run --rm cli \
    theme is-installed "$THEME_PARENT" \
    --path=/var/www/public/wp

"${COMPOSE[@]}" run --rm cli \
    theme is-installed "$THEME_ACTIVE" \
    --path=/var/www/public/wp

"${COMPOSE[@]}" run --rm cli \
    theme activate "$THEME_ACTIVE" \
    --path=/var/www/public/wp

echo "==> Checking WordPress state"

"${COMPOSE[@]}" run --rm cli \
    core is-installed \
    --path=/var/www/public/wp

ACTUAL_THEME="$(
    "${COMPOSE[@]}" run --rm cli \
        option get stylesheet \
        --path=/var/www/public/wp
)"

ACTUAL_PARENT="$(
    "${COMPOSE[@]}" run --rm cli \
        option get template \
        --path=/var/www/public/wp
)"

if [[ "$ACTUAL_THEME" != "$THEME_ACTIVE" ]]; then
    echo "Unexpected active theme: expected '$THEME_ACTIVE', got '$ACTUAL_THEME'." >&2
    exit 1
fi

if [[ "$ACTUAL_PARENT" != "$THEME_PARENT" ]]; then
    echo "Unexpected parent theme: expected '$THEME_PARENT', got '$ACTUAL_PARENT'." >&2
    exit 1
fi

echo "==> Checking HTTP runtime"

"${COMPOSE[@]}" exec -T app php -r '
    $body = @file_get_contents("http://127.0.0.1/wp/wp-login.php");

    if ($body === false) {
        fwrite(STDERR, "Unable to request WordPress login page.\n");
        exit(1);
    }

    if (!str_contains($body, "user_login")) {
        fwrite(STDERR, "Unexpected WordPress login response.\n");
        exit(1);
    }
'

echo "==> Smoke test passed"
