# SSH deployment target

DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_ROOT=
DEPLOY_DOCUMENT_ROOT=

# Required SSH private key file used by Deployer.
# Local: point to an existing private key.
# CI: point to the temporary file materialized from the CI secret.
DEPLOY_SSH_KEY_FILE=

# PHP CLI binary used for remote WordPress operations.
# Leave empty to use the default `php` from PATH.
DEPLOY_PHP_BINARY=

# Deployment target adapter.
DEPLOY_ADAPTER=hostinger
DEPLOY_KEEP_RELEASES=5

# Initial WordPress installation

INSTALL_SITE_TITLE="Example site"
INSTALL_ADMIN_USER=
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_EMAIL=

# Prevent search engine indexing by default.
INSTALL_BLOG_PUBLIC=0

# Runtime configuration to persist as shared/.env.
# Relative paths are resolved from the repository root.
INSTALL_ENV_FILE=.env.runtime.prod.local
