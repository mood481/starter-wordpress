# Non-secret deployment profile.
# In Buildkite, store the populated contents as the WP_GEAR_DEPLOY_CONFIG secret.

DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22

DEPLOY_ROOT=
DEPLOY_DOCUMENT_ROOT=

DEPLOY_ADAPTER=hostinger
DEPLOY_KEEP_RELEASES=5

# Optional provider-specific PHP CLI path.
DEPLOY_PHP_BINARY=
